#!/bin/sh
# Poll wan carrier_changes while ≥2 Wi-Fi radios are up. If the counter
# climbs by ≥4 in a 60s window, pulse the fan and bounce wan (openwrt#26690).
# Samples every 30s; the window compares against the reading from two ticks ago
# so slow flap storms (e.g. +2 per interval) still trip recovery.

STATE=/tmp/milkflint4-wan-watch
mkdir -p "$STATE"

pulse_fan() {
	cd=/sys/class/thermal/cooling_device0
	[ -w "$cd/cur_state" ] || return 0
	prev=$(cat "$cd/cur_state" 2>/dev/null || echo 0)
	[ "$prev" -ge 1 ] 2>/dev/null || echo 1 > "$cd/cur_state" 2>/dev/null || true
	sleep 10
	now=$(cat "$cd/cur_state" 2>/dev/null || echo 0)
	[ "$prev" = 0 ] && [ "$now" = 1 ] && echo 0 > "$cd/cur_state" 2>/dev/null || true
}

bounce_wan() {
	logger -t milkflint4-wan-watch "bouncing wan after flap storm"
	ip link set wan down 2>/dev/null || true
	sleep 1
	ip link set wan up 2>/dev/null || true
}

# Count phys with at least one UP BSS — not every guest/AP netdev.
radios_up() {
	n=0
	for phy in /sys/class/ieee80211/phy*; do
		[ -d "$phy" ] || continue
		up=0
		for d in "$phy"/device/net/*/operstate; do
			[ -f "$d" ] || continue
			[ "$(cat "$d" 2>/dev/null)" = up ] && up=1 && break
		done
		[ "$up" = 1 ] && n=$((n + 1))
	done
	echo "$n"
}

# Wait for wan (DSA / PHY may appear after procd starts us). Exit non-zero so
# procd respawns if it never shows up within ~5 minutes.
i=0
while [ ! -d /sys/class/net/wan ]; do
	i=$((i + 1))
	[ "$i" -gt 60 ] && {
		logger -t milkflint4-wan-watch "wan netdev missing after wait; exiting for respawn"
		exit 1
	}
	sleep 5
done

seed=$(cat /sys/class/net/wan/carrier_changes 2>/dev/null || echo 0)
# carrier_60: reading ~60s ago; carrier_30: reading ~30s ago
echo "$seed" > "$STATE/carrier_60"
echo "$seed" > "$STATE/carrier_30"

while sleep 30; do
	[ -d /sys/class/net/wan ] || continue
	now=$(cat /sys/class/net/wan/carrier_changes 2>/dev/null || echo 0)
	ago60=$(cat "$STATE/carrier_60" 2>/dev/null || echo 0)
	ago30=$(cat "$STATE/carrier_30" 2>/dev/null || echo 0)

	# Slide the 60s window: previous 30s sample becomes the 60s baseline.
	echo "$ago30" > "$STATE/carrier_60"
	echo "$now" > "$STATE/carrier_30"

	delta=$((now - ago60))
	[ "$delta" -lt 0 ] && delta=0

	ru=$(radios_up)
	if [ "$ru" -ge 2 ] && [ "$delta" -ge 4 ]; then
		# cooldown 5 minutes between recoveries
		last=$(cat "$STATE/last_fix" 2>/dev/null || echo 0)
		ts=$(date +%s)
		if [ $((ts - last)) -ge 300 ]; then
			logger -t milkflint4-wan-watch \
				"carrier_changes +$delta in ~60s with $ru radios; fan pulse + bounce"
			pulse_fan
			bounce_wan
			echo "$ts" > "$STATE/last_fix"
			# Reseed the window after a bounce so we don't immediately re-trigger.
			fresh=$(cat /sys/class/net/wan/carrier_changes 2>/dev/null || echo 0)
			echo "$fresh" > "$STATE/carrier_60"
			echo "$fresh" > "$STATE/carrier_30"
		fi
	fi
done
