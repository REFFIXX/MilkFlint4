#!/bin/sh /etc/rc.common
# GL-BE14000: background watchdog for RTL8261 10G WAN flaps (openwrt#26690).
# Hotplug recovers after ifdown bursts; this catches slow flap storms while
# two+ radios are up even when netifd does not emit a burst of ifdown events.

START=99
STOP=10
USE_PROCD=1

NAME=milkflint4-wan-watch
PROG=/usr/sbin/milkflint4-wan-watch

start_service() {
	[ "$(board_name)" = glinet,gl-be14000 ] || return 0
	[ -x "$PROG" ] || return 0
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
