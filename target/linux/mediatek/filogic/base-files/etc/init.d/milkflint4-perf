#!/bin/sh /etc/rc.common
# Re-assert Flint 4 max-performance knobs after boot (governor can reset).

START=98

boot() {
	[ "$(board_name)" = glinet,gl-be14000 ] || exit 0
	[ "$(uci -q get milkflint.defaults.flint4_perf)" = 1 ] || exit 0

	for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor \
		/sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
		[ -w "$gov" ] || continue
		echo performance > "$gov" 2>/dev/null || true
	done

	[ -f /etc/sysctl.d/22-milkflint4-be14000.conf ] && \
		sysctl -e -p /etc/sysctl.d/22-milkflint4-be14000.conf >/dev/null 2>&1 || true
}
