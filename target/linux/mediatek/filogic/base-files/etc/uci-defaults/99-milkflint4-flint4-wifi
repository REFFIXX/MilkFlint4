#!/bin/sh
# Flint 4 (GL-BE14000) Wi-Fi defaults on top of MilkFlint's generic tweaks:
# MT7996 tri-band Wi-Fi 7, WED on the MT7988, and a sane 6 GHz PSC start.

[ "$(board_name)" = glinet,gl-be14000 ] || exit 0

. /lib/functions.sh

# MilkFlint's Performance Tuning WED path (mt7996e). On by default for this
# board so Wi-Fi <-> WAN can leave the CPU once flow offloading is enabled.
# First-boot module load is seeded earlier by lib/preinit/80_milkflint4-flint4-wed
# (uci-defaults run after kmodloader); this marks the once-default and keeps
# modules.conf in step if preinit could not run (e.g. recovered config).
if [ -z "$(uci -q get milkflint.defaults.flint4_wed)" ]; then
	uci -q get milkflint.wifi >/dev/null || uci set milkflint.wifi=wifi
	uci set milkflint.wifi.wed=1
	uci -q batch <<-UCI
		set milkflint.defaults=defaults
		set milkflint.defaults.flint4_wed='1'
		commit milkflint
	UCI
	[ -x /usr/libexec/milkflint/wed ] && /usr/libexec/milkflint/wed conf
fi

# Uplink MU-MIMO / OFDMA off by default (OddBlueDog / 0.87a muru): mt76 UL
# MU-MIMO can stall best-effort TX ~65–300 ms. Unset muru_<band>_*_ul means
# off in wifi-muru; clear legacy global keys and apply per band.
if [ -z "$(uci -q get milkflint.defaults.flint4_muru_ul)" ]; then
	uci -q get milkflint.wifi >/dev/null || uci set milkflint.wifi=wifi
	uci -q delete milkflint.wifi.muru_mimo_ul
	uci -q delete milkflint.wifi.muru_ofdma_ul
	for band in 2g 5g 6g; do
		uci -q delete "milkflint.wifi.muru_${band}_mimo_ul"
		uci -q delete "milkflint.wifi.muru_${band}_ofdma_ul"
	done
	uci -q batch <<-UCI
		set milkflint.defaults=defaults
		set milkflint.defaults.flint4_muru_ul='1'
		commit milkflint
	UCI
	[ -x /usr/libexec/milkflint/wifi-muru ] && /usr/libexec/milkflint/wifi-muru
fi

# Best-effort latency tweak (MilkFlint wifi_be) also on 6 GHz: same long
# TXOP / short backoff problem under download as on 5 GHz.
if [ -z "$(uci -q get milkflint.defaults.flint4_wifi_be6)" ]; then
	for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
		[ "$(uci -q get "wireless.$radio.band")" = 6g ] || continue
		uci set "wireless.$radio.tx_burst=0"
		uci -q del_list "wireless.$radio.hostapd_options=tx_queue_data2_cwmin=31"
		uci add_list "wireless.$radio.hostapd_options=tx_queue_data2_cwmin=31"
	done
	uci -q commit wireless
	uci -q batch <<-UCI
		set milkflint.defaults=defaults
		set milkflint.defaults.flint4_wifi_be6='1'
		commit milkflint
	UCI
fi

# Prefer an explicit 6 GHz PSC channel when still on auto: ACS on two MLD
# links (5 + 6 GHz) can deadlock; PSC 37 is widely usable once a country
# that allows 6 GHz is set.
if [ -z "$(uci -q get milkflint.defaults.flint4_psc6)" ]; then
	for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
		[ "$(uci -q get "wireless.$radio.band")" = 6g ] || continue
		ch=$(uci -q get "wireless.$radio.channel")
		[ -z "$ch" ] || [ "$ch" = auto ] || continue
		uci set "wireless.$radio.channel=37"
	done
	uci -q commit wireless
	uci -q batch <<-UCI
		set milkflint.defaults=defaults
		set milkflint.defaults.flint4_psc6='1'
		commit milkflint
	UCI
fi

# Default Wi-Fi country US on first boot (MilkFlint4). MilkFlint's generic
# 91-milkflint-wifi seeds empty radios with GB before this runs, so treat GB
# (and empty/00) as the unset first-boot default. A later user choice sticks
# because this only runs once (flint4_country_us). US 6 GHz LPI AP works with
# our wireless-regdb patch (510-us-6ghz-lpi-allow-ap).
if [ -z "$(uci -q get milkflint.defaults.flint4_country_us)" ]; then
	for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
		c=$(uci -q get "wireless.$radio.country")
		[ -z "$c" ] || [ "$c" = 00 ] || [ "$c" = GB ] || continue
		uci set "wireless.$radio.country=US"
	done
	uci -q commit wireless
	uci -q batch <<-UCI
		set milkflint.defaults=defaults
		set milkflint.defaults.flint4_country_us='1'
		set milkflint.defaults.flint4_country_us_fix='1'
		commit milkflint
	UCI
fi

# Migrate images that set flint4_country_us=1 without writing US (91 had
# already seeded GB). If every radio is still GB, apply US once.
if [ "$(uci -q get milkflint.defaults.flint4_country_us)" = 1 ] && \
	[ -z "$(uci -q get milkflint.defaults.flint4_country_us_fix)" ]; then
	all_gb=1
	any=
	for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
		any=1
		c=$(uci -q get "wireless.$radio.country")
		[ "$c" = GB ] || all_gb=0
	done
	if [ -n "$any" ] && [ "$all_gb" = 1 ]; then
		for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
			uci set "wireless.$radio.country=US"
		done
		uci -q commit wireless
	fi
	uci -q batch <<-UCI
		set milkflint.defaults=defaults
		set milkflint.defaults.flint4_country_us_fix='1'
		commit milkflint
	UCI
fi

exit 0

