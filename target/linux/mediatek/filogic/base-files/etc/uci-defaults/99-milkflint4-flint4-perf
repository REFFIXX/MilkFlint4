#!/bin/sh
# MilkFlint4 epic defaults for GL-BE14000: keep MilkFlint's Performance Tuning
# stack, then pin MT7988-class knobs for multi-gig WAN + tri-band Wi‑Fi 7.
# Runs once (milkflint.defaults.flint4_perf); user changes in the UI stick.

[ "$(board_name)" = glinet,gl-be14000 ] || exit 0

. /lib/functions.sh

write_sysctl() {
	# 2 GB DDR4 MT7988A — sized for a busy home / lab gateway on 2.5G–10G.
	cat > /etc/sysctl.d/22-milkflint4-be14000.conf <<'EOF'
# MilkFlint4 / Flint 4 (GL-BE14000) — do not edit; rewritten by uci-defaults
# when milkflint.defaults.flint4_perf is cleared.

# Conntrack: plenty of room for many LAN clients + Wi‑Fi 7 + VPN
net.netfilter.nf_conntrack_max=262144
net.netfilter.nf_conntrack_buckets=65536
net.netfilter.nf_conntrack_tcp_timeout_established=7440
net.netfilter.nf_conntrack_udp_timeout=60
net.netfilter.nf_conntrack_udp_timeout_stream=180

# Socket / backlog headroom for multi-gig bursts
net.core.somaxconn=4096
net.core.netdev_max_backlog=5000
net.core.netdev_budget=600
net.core.netdev_budget_usecs=8000
net.core.optmem_max=65536
net.core.rmem_default=262144
net.core.wmem_default=262144
net.core.rmem_max=16777216
net.core.wmem_max=16777216

# TCP: fat pipes, fewer stalls after idle, fast open
net.ipv4.tcp_rmem=4096 262144 16777216
net.ipv4.tcp_wmem=4096 262144 16777216
net.ipv4.tcp_max_syn_backlog=8192
net.ipv4.tcp_max_tw_buckets=262144
net.ipv4.tcp_fin_timeout=15
net.ipv4.tcp_slow_start_after_idle=0
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_tw_reuse=1
net.ipv4.tcp_keepalive_time=300
net.ipv4.tcp_keepalive_intvl=30
net.ipv4.tcp_keepalive_probes=5

# Local forwarding / neigh under many Wi‑Fi clients
net.ipv4.neigh.default.gc_thresh1=1024
net.ipv4.neigh.default.gc_thresh2=4096
net.ipv4.neigh.default.gc_thresh3=8192
net.ipv6.neigh.default.gc_thresh1=1024
net.ipv6.neigh.default.gc_thresh2=4096
net.ipv6.neigh.default.gc_thresh3=8192

# Prefer keeping free memory for network bursts (no swap on eMMC builds)
vm.swappiness=0
vm.vfs_cache_pressure=50
EOF
	[ -x /sbin/sysctl ] && sysctl -e -p /etc/sysctl.d/22-milkflint4-be14000.conf >/dev/null 2>&1 || true
}

set_cpu_performance() {
	# Max sustained throughput on four A73s; thermal trips + fan cover heat.
	for gov in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor \
		/sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
		[ -w "$gov" ] || continue
		echo performance > "$gov" 2>/dev/null || true
	done
	# Persist across softirq/cpufreq reloads when the package exists
	if [ -f /etc/config/cpufreq ]; then
		uci -q set cpufreq.cpufreq.governor0=performance
		uci -q set cpufreq.cpufreq.governor1=performance
		uci -q set cpufreq.cpufreq.governor2=performance
		uci -q set cpufreq.cpufreq.governor3=performance
		uci -q commit cpufreq
	fi
}

if [ -z "$(uci -q get milkflint.defaults.flint4_perf)" ]; then
	write_sysctl
	set_cpu_performance

	# Hardware RSS layout (MilkFlint packet-steering) — never RPS fallback
	uci -q get milkflint.steering >/dev/null || uci set milkflint.steering=steering
	uci set milkflint.steering.rss=1
	uci -q delete milkflint.steering.layout
	# Real-time NAPI on PDMA rings; spread Wi‑Fi worker threads too
	uci -q delete milkflint.steering.rings_rt
	uci -q delete milkflint.steering.wifi_all
	# Tighter RX interrupt coalescing default when unset (µs); leave UI free
	[ -n "$(uci -q get milkflint.steering.rx_delay)" ] || \
		uci set milkflint.steering.rx_delay=20

	# Ensure MilkFlint / OpenWrt packet steering is on
	uci -q get network.globals >/dev/null || uci set network.globals=globals
	uci -q delete network.globals.packet_steering

	# Firewall: software + hardware flow offload (pairs with WED on mt7996e)
	for sec in $(uci -q show firewall | sed -n "s/^firewall\.\([^=]*\)=defaults$/\1/p"); do
		uci set "firewall.$sec.flow_offloading=1"
		uci set "firewall.$sec.flow_offloading_hw=1"
		uci set "firewall.$sec.synflood_protect=1"
	done

	# WED stays the MilkFlint4 Wi‑Fi offload default (99-milkflint4-flint4-wifi)
	uci -q get milkflint.wifi >/dev/null || uci set milkflint.wifi=wifi
	[ -n "$(uci -q get milkflint.wifi.wed)" ] || uci set milkflint.wifi.wed=1

	uci -q commit milkflint
	uci -q commit network
	uci -q commit firewall

	uci -q batch <<-UCI
		set milkflint.defaults=defaults
		set milkflint.defaults.flint4_perf='1'
		commit milkflint
	UCI

	# Apply steering / WED if the MilkFlint helpers are already present
	[ -x /usr/libexec/milkflint/wed ] && /usr/libexec/milkflint/wed conf
	/etc/init.d/packet_steering enabled 2>/dev/null && /etc/init.d/packet_steering reload 2>/dev/null || true
	/etc/init.d/firewall enabled 2>/dev/null && /etc/init.d/firewall reload 2>/dev/null || true
	[ -x /etc/init.d/milkflint4-perf ] && /etc/init.d/milkflint4-perf enable
fi

exit 0
