# MilkFlint Sim — x86_64 OpenWrt appliance for UI / non-Wi-Fi testing.
#   cp milkflint/sim/diffconfig .config && make defconfig
#   make FILES="$PWD/milkflint/sim/files" -j"$(nproc)" world V=s IGNORE_ERRORS='n m'
#
# Not a Flint 4: no mt7996, WED, RTL8261, LCD, or filogic. Same MilkFlint UI
# + soft services (SQM, DNS, VPN, banIP, usteer/mesh packages) on virtio.
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="MilkFlint-Sim"
CONFIG_VERSION_NUMBER="1.5"
CONFIG_VERSION_CODE_FILENAMES=y
CONFIG_VERSION_MANUFACTURER="MilkFlint4"
CONFIG_VERSION_MANUFACTURER_URL="https://github.com/REFFIXX/MilkFlint4"
CONFIG_VERSION_HOME_URL="https://github.com/REFFIXX/MilkFlint4"
CONFIG_VERSION_BUG_URL="https://github.com/REFFIXX/MilkFlint4/issues"
CONFIG_VERSION_SUPPORT_URL="https://github.com/REFFIXX/MilkFlint4/issues"
CONFIG_VERSION_FIRMWARE_URL="https://github.com/REFFIXX/MilkFlint4/releases"

CONFIG_DEVEL=y
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="milkflint-sim"

# Lean guest: no ALL_KMODS (keeps the sim image small and buildable on a laptop).
# CONFIG_ALL_KMODS is not set

# Virtio nic + disk helpers for QEMU
CONFIG_PACKAGE_kmod-virtio-net=y
CONFIG_PACKAGE_kmod-virtio-blk=y
CONFIG_PACKAGE_kmod-virtio-scsi=y
CONFIG_VIRTIO_GUEST_SUPPORT=y

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-footstrap=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set

CONFIG_PACKAGE_milkflint-ui=y
CONFIG_PACKAGE_milkflint-rtprio=y
# milkflint4-lcd-splash is filogic-only — omit on x86
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_dnsproxy=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_milkflint-bcrypt=y
CONFIG_PACKAGE_banip=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# Same roaming/mesh package set as the router image (no radios in QEMU).
CONFIG_PACKAGE_wpad-mbedtls=y
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-mini is not set
CONFIG_PACKAGE_usteer=y
# CONFIG_PACKAGE_dawn is not set
CONFIG_PACKAGE_mesh11sd=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_vxlan=y
CONFIG_PACKAGE_kmod-nft-bridge=y

# Combined ext4 image boots cleanly under QEMU (gunzip → raw).
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
