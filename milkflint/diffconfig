# MilkFlint4 build configuration for the GL.iNet GL-BE14000 (Flint 4):
#   cp milkflint/diffconfig .config && make defconfig
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-be14000=y

# MilkFlint4 0.3a on OpenWrt main-line mediatek (kernel 6.18) with
# Flint 4 hardware RSS, RTL8261C/D PHY firmware, and a full kmod set so
# opkg/apk extras match this image's vermagic (not downloads.openwrt.org).
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="MilkFlint4"
CONFIG_VERSION_NUMBER="0.4a-k7"
CONFIG_VERSION_CODE_FILENAMES=y
CONFIG_VERSION_MANUFACTURER="MilkFlint4"
CONFIG_VERSION_MANUFACTURER_URL="https://github.com/REFFIXX/MilkFlint4"
CONFIG_VERSION_HOME_URL="https://github.com/REFFIXX/MilkFlint4"
CONFIG_VERSION_BUG_URL="https://github.com/REFFIXX/MilkFlint4/issues"
CONFIG_VERSION_SUPPORT_URL="https://github.com/REFFIXX/MilkFlint4/issues"
CONFIG_VERSION_FIRMWARE_URL="https://github.com/REFFIXX/MilkFlint4/releases"

# Filogic's package ABI is cortex-a53 across MT798x (including MT7988's
# A73 cores). Keep -mcpu=cortex-a53 so kmods match. CONFIG_DEVEL is required
# for KERNEL_CFLAGS.
CONFIG_DEVEL=y
CONFIG_KERNEL_CFLAGS="-mcpu=cortex-a53"
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="milkflint4"
# Prefer host clang for eBPF (avoids multi-hour tools/llvm-bpf on builders).
# CONFIG_BPF_TOOLCHAIN_BUILD_LLVM is not set
# CONFIG_BPF_TOOLCHAIN_NONE is not set
CONFIG_BPF_TOOLCHAIN_HOST=y

# Linux 7.3: keep ALL_KMODS so extras match this image's vermagic.
# Hard-fail feed packages are disabled below; build with IGNORE_ERRORS='n m'.
CONFIG_ALL_KMODS=y

# Flint 4 Wi-Fi 7 (mt7996)
CONFIG_PACKAGE_kmod-mt7996e=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-mt7996-233-firmware=y
CONFIG_PACKAGE_kmod-mt7996-firmware-common=y

# BE14000 Ethernet / panel / touch / 10G PHY firmware
CONFIG_PACKAGE_kmod-sfp=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-backlight-pwm=y
CONFIG_PACKAGE_kmod-drm-panel-mipi-dbi=y
CONFIG_PACKAGE_mipi-dbi-glinet-gl-be14000=y
CONFIG_PACKAGE_kmod-input-touchscreen-hynitron-cst3530=y
CONFIG_PACKAGE_kmod-input-evdev=y
CONFIG_PACKAGE_bridger=y
CONFIG_PACKAGE_mt7988-wo-firmware=y
CONFIG_PACKAGE_rtl8261c-firmware=y
CONFIG_PACKAGE_rtl826x-firmware=y
CONFIG_PACKAGE_kmod-i2c-gpio=y

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-footstrap=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set

CONFIG_PACKAGE_milkflint-ui=y
CONFIG_PACKAGE_milkflint-rtprio=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_dnsproxy=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_milkflint-bcrypt=y
CONFIG_PACKAGE_banip=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_kmod-nft-bridge-offload=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y

CONFIG_DISPLAY_SUPPORT=y

