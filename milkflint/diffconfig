# MilkFlint4 build configuration for the GL.iNet GL-BE14000 (Flint 4):
#   cp milkflint/diffconfig .config && make defconfig
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-be14000=y

# MilkFlint4 1.1 on OpenWrt main-line mediatek (kernel 6.18) with
# Flint 4 hardware RSS, RTL8261C/D PHY firmware, and a full kmod set so
# opkg/apk extras match this image's vermagic (not downloads.openwrt.org).
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="MilkFlint4"
CONFIG_VERSION_NUMBER="1.1"
CONFIG_VERSION_CODE_FILENAMES=y
CONFIG_VERSION_MANUFACTURER="MilkFlint4"
CONFIG_VERSION_MANUFACTURER_URL="https://github.com/REFFIXX/MilkFlint4"
CONFIG_VERSION_HOME_URL="https://github.com/REFFIXX/MilkFlint4"
CONFIG_VERSION_BUG_URL="https://github.com/REFFIXX/MilkFlint4/issues"
CONFIG_VERSION_SUPPORT_URL="https://github.com/REFFIXX/MilkFlint4/issues"
CONFIG_VERSION_FIRMWARE_URL="https://github.com/REFFIXX/MilkFlint4/releases"

# Filogic's package ABI is cortex-a53 across MT798x (including MT7988's
# A73 cores). Keep -mcpu=cortex-a53 so kmods match. CONFIG_DEVEL is required
# for KERNEL_CFLAGS.
CONFIG_DEVEL=y
CONFIG_KERNEL_CFLAGS="-mcpu=cortex-a53"
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="milkflint4"

# Ship the full kmod set with this image's vermagic. Official OpenWrt
# snapshot kmods will not load here (custom RSS/CAKE/kernel config);
# install extras from this build's package feed instead.
CONFIG_ALL_KMODS=y

# Flint 4 Wi-Fi 7 (mt7996)
CONFIG_PACKAGE_kmod-mt7996e=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-mt7996-233-firmware=y
CONFIG_PACKAGE_kmod-mt7996-firmware-common=y

# BE14000 Ethernet / panel / touch / 10G PHY firmware
CONFIG_PACKAGE_kmod-sfp=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-backlight-pwm=y
CONFIG_PACKAGE_kmod-drm-panel-mipi-dbi=y
CONFIG_PACKAGE_mipi-dbi-glinet-gl-be14000=y
CONFIG_PACKAGE_kmod-input-touchscreen-hynitron-cst3530=y
CONFIG_PACKAGE_kmod-input-evdev=y
CONFIG_PACKAGE_bridger=y
CONFIG_PACKAGE_mt7988-wo-firmware=y
CONFIG_PACKAGE_rtl8261c-firmware=y
CONFIG_PACKAGE_rtl826x-firmware=y
CONFIG_PACKAGE_kmod-i2c-gpio=y

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-footstrap=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set

CONFIG_PACKAGE_milkflint-ui=y
CONFIG_PACKAGE_milkflint-rtprio=y
CONFIG_PACKAGE_milkflint4-lcd-splash=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_dnsproxy=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_milkflint-bcrypt=y
CONFIG_PACKAGE_banip=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_kmod-nft-bridge-offload=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y

# Wi-Fi roaming (802.11k/r/v) + 802.11s mesh — OpenWrt 25.x path
# Full wpad is required for 802.11k (wpad-basic lacks it).
CONFIG_PACKAGE_wpad-mbedtls=y
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-mini is not set
CONFIG_PACKAGE_usteer=y
# CONFIG_PACKAGE_dawn is not set
CONFIG_PACKAGE_mesh11sd=y
# mesh11sd full function (vxlan guest tunnel + bridge helpers)
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_vxlan=y
CONFIG_PACKAGE_kmod-nft-bridge=y

CONFIG_DISPLAY_SUPPORT=y

# Out-of-tree PF_RING is not 6.18-ready (dev_get_flags); keep ALL_KMODS otherwise.
# CONFIG_PACKAGE_kmod-pf-ring is not set
# Optional out-of-tree / feed kmods that break on 6.18+ and are unused on
# GL-BE14000. World builds use IGNORE_ERRORS="n m" so remaining ALL_KMODS
# packaging gaps do not block the sysupgrade image.
# CONFIG_PACKAGE_kmod-dahdi is not set
# CONFIG_PACKAGE_kmod-dahdi-dummy is not set
# CONFIG_PACKAGE_kmod-dahdi-echocan-oslec is not set
# CONFIG_PACKAGE_kmod-dahdi-hfcs is not set
# CONFIG_PACKAGE_kmod-ipt-account is not set
# CONFIG_PACKAGE_kmod-ipt-pknock is not set
# CONFIG_PACKAGE_kmod-ipt-rtpengine is not set
# CONFIG_PACKAGE_iptables-mod-account is not set
# CONFIG_PACKAGE_iptables-mod-pknock is not set
# CONFIG_PACKAGE_xtables-addons is not set
# CONFIG_PACKAGE_kmod-cryptodev is not set
# CONFIG_PACKAGE_kmod-nat46 is not set
# CONFIG_PACKAGE_kmod-r8101 is not set
# When building: make IGNORE_ERRORS="n m" world  # ALL_KMODS packaging gaps on 6.18
# CONFIG_PACKAGE_kmod-ath10k-ct is not set
# CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers is not set
# CONFIG_PACKAGE_kmod-batman-adv is not set
# CONFIG_PACKAGE_kmod-rtl8812au-ct is not set
# CONFIG_PACKAGE_kmod-r8168 is not set
# CONFIG_PACKAGE_kmod-r8168-rss is not set
# CONFIG_PACKAGE_kmod-atm is not set
# CONFIG_PACKAGE_linux-atm is not set
# mt792x needs CFG80211_NAN_MAX_PEER_MAPS (not in OpenWrt 6.18 mac80211); BE14000 uses mt7996.
# CONFIG_PACKAGE_kmod-mt7921-common is not set
# CONFIG_PACKAGE_kmod-mt7921e is not set
# CONFIG_PACKAGE_kmod-mt7921s is not set
# CONFIG_PACKAGE_kmod-mt7921u is not set
# CONFIG_PACKAGE_kmod-mt7921-firmware is not set
# CONFIG_PACKAGE_kmod-mt7925-common is not set
# CONFIG_PACKAGE_kmod-mt7925e is not set
# CONFIG_PACKAGE_kmod-mt7925u is not set
# CONFIG_PACKAGE_kmod-mt7925-firmware is not set
# CONFIG_PACKAGE_kmod-mt792x-common is not set
# CONFIG_PACKAGE_kmod-mt792x-usb is not set
