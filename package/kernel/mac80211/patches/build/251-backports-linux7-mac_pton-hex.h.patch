From: MilkFlint <milkflint@local>
Subject: [PATCH] backports: include linux/hex.h for mac_pton on Linux 7+

mac_pton moved out of the historical include path; pull hex.h in via
backport netdevice.h so cfg80211/mac80211 debugfs and drivers see it.

---
--- a/backport-include/linux/netdevice.h
+++ b/backport-include/linux/netdevice.h
@@ -2,6 +2,11 @@
 #define __BACKPORT_NETDEVICE_H
 #include_next <linux/netdevice.h>
 #include <linux/version.h>
+
+#if LINUX_VERSION_IS_GEQ(7, 0, 0)
+/* mac_pton() lives in linux/hex.h since the 7.x move */
+#include <linux/hex.h>
+#endif
 #include <backport/magic.h>
 
 #if LINUX_VERSION_IS_LESS(4,15,0)
