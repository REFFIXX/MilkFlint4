From: MilkFlint <milkflint@local>
Subject: [PATCH] backports: do not redefine SOCKWQ_ASYNC_* on Linux 7+

Those symbols are enum constants on modern kernels. #ifndef cannot
see enums, so the backport aliases shadow them with macros that expand
to the removed SOCK_ASYNC_* names and break the build on 7.3.

---
--- a/backport-include/linux/net.h
+++ b/backport-include/linux/net.h
@@ -3,12 +3,15 @@
 #include_next <linux/net.h>
 #include <linux/static_key.h>
 
-
+/* Enum constants are invisible to #ifndef; only alias on pre-7 kernels
+ * that still expose SOCK_ASYNC_* names. */
+#if LINUX_VERSION_IS_LESS(7, 0, 0)
 #ifndef SOCKWQ_ASYNC_NOSPACE
 #define SOCKWQ_ASYNC_NOSPACE   SOCK_ASYNC_NOSPACE
 #endif
 #ifndef SOCKWQ_ASYNC_WAITDATA
 #define SOCKWQ_ASYNC_WAITDATA   SOCK_ASYNC_WAITDATA
 #endif
+#endif /* < 7.0 */
 
 #endif /* __BACKPORT_LINUX_NET_H */
