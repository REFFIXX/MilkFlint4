From: MilkFlint4 <builder@milkflint4>
Date: Sat, 21 Nov 2026 18:45:00 +0100
Subject: [PATCH] wifi: mt76: pass wcid to mtk_wed_device_ppe_check

MilkFlint kernel pending-6.18 797-01 extends mtk_wed_device_ppe_check
with a wcid argument for PPE flow matching. Update mt7915/mt7996 call
sites so the out-of-tree mt76 tree builds against that API.

--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -265,8 +265,9 @@ mt7915_wed_check_ppe(struct mt7915_dev *
 	skb->dev = wdev->netdev;
 
 	mtk_wed_device_ppe_check(&dev->mt76.mmio.wed, skb,
 				 FIELD_GET(MT_DMA_PPE_CPU_REASON, info),
-				 FIELD_GET(MT_DMA_PPE_ENTRY, info));
+				 FIELD_GET(MT_DMA_PPE_ENTRY, info),
+				 msta->wcid.idx);
 }
 
 static int
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -406,8 +406,9 @@ mt7996_wed_check_ppe(struct mt7996_dev *
 	skb->dev = wdev->netdev;
 
 	mtk_wed_device_ppe_check(&dev->mt76.mmio.wed, skb,
 				 FIELD_GET(MT_DMA_PPE_CPU_REASON, info),
-				 FIELD_GET(MT_DMA_PPE_ENTRY, info));
+				 FIELD_GET(MT_DMA_PPE_ENTRY, info),
+				 msta->wcid.idx);
 }
 
 static int
