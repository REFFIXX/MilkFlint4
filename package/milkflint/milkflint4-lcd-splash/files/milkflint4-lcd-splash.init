#!/bin/sh /etc/rc.common
# Flint 4 front-panel LCD: procd runs lcd-loop; STOP blanks the panel.

START=99
STOP=01
USE_PROCD=1

PROG=/usr/libexec/milkflint/lcd-loop
BLANK=/sys/class/graphics/fb0/blank

boot() {
	start
}

wait_fb() {
	local i
	for i in $(seq 1 40); do
		[ -e /dev/fb0 ] && return 0
		sleep 1
	done
	return 1
}

blank_panel() {
	[ -e "$BLANK" ] && echo 1 > "$BLANK" 2>/dev/null
}

start_service() {
	wait_fb || return 1
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	blank_panel
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger milkflint
}
