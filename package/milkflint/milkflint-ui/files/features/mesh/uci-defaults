#!/bin/sh
# Leave mesh11sd auto_config off until the Mesh page turns it on. Do not
# rewrite wireless/network ownership before the user opts in.
[ -e /etc/config/mesh11sd ] || touch /etc/config/mesh11sd
uci -q show mesh11sd.setup >/dev/null 2>&1 || {
	uci set mesh11sd.setup=mesh11sd
	uci set mesh11sd.setup.enabled='1'
	uci set mesh11sd.setup.auto_config='0'
	uci set mesh11sd.setup.portal_detect='1'
	uci commit mesh11sd
}
# Mark seeded once so later boots don't rewrite mesh11sd. Only force
# auto_config=0 when creating the setup section above — never clobber a
# box that already had mesh11sd configured before MilkFlint arrived.
if [ -z "$(uci -q get milkflint.mesh.seeded)" ]; then
	uci -q batch <<-UCI
		set milkflint.mesh=mesh
		set milkflint.mesh.seeded='1'
		commit milkflint
	UCI
fi
exit 0
