#!/usr/bin/ucode
// MilkFlint 24 h data-usage history (procd instance on milkflint-data-statistics).
// Every INTERVAL seconds it snapshots nlbwmon's per-MAC totals for the current
// accounting period and keeps the last KEEP seconds in /tmp (RAM tmpfs — not
// flash). Off by default (milkflint.datastats.history); when off the init script
// deletes the state file. Samples are absolute counters; the UI diffs them.
'use strict';

import { cursor } from 'uci';
import { readfile, writefile, rename, mkdir, popen, unlink, access } from 'fs';

const DIR = '/tmp/milkflint';
const STATE = DIR + '/usage-history.json';
const INTERVAL = 300;	// 5 minutes
const KEEP = 24 * 3600;

function history_on() {
	return cursor().get('milkflint', 'datastats', 'history') == '1';
}

function now_ms() {
	const t = clock(true);
	return t[0] * 1000 + t[1] / 1000000.0;
}

// { mac: [ rx_bytes, tx_bytes ] } for the current nlbwmon period; {} if unavailable
function snapshot() {
	if (!access('/usr/sbin/nlbw', 'x'))
		return {};
	const p = popen('nlbw -c json -g mac 2>/dev/null', 'r');
	if (!p)
		return {};
	let table = null;
	try {
		table = json(p.read('all'));
	}
	catch (e) {
		table = null;
	}
	p.close();
	if (type(table?.columns) != 'array' || type(table?.data) != 'array')
		return {};
	const cm = index(table.columns, 'mac');
	const crx = index(table.columns, 'rx_bytes');
	const ctx = index(table.columns, 'tx_bytes');
	if (cm < 0 || crx < 0 || ctx < 0)
		return {};
	const out = {};
	for (let row in table.data) {
		const mac = lc(sprintf('%s', row[cm] ?? ''));
		if (!match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
			continue;
		const rx = +row[crx] || 0;
		const tx = +row[ctx] || 0;
		const prev = out[mac];
		out[mac] = prev ? [ prev[0] + rx, prev[1] + tx ] : [ rx, tx ];
	}
	return out;
}

function load_samples() {
	try {
		const prev = json(readfile(STATE) ?? 'null');
		if (type(prev?.samples) == 'array')
			return prev.samples;
	}
	catch (e) {
		// start fresh
	}
	return [];
}

function save(samples) {
	mkdir(DIR);
	writefile(STATE + '.tmp', sprintf('%J', { interval: INTERVAL, samples }));
	rename(STATE + '.tmp', STATE);
}

function prune(samples, now) {
	const cut = now - KEEP;
	return filter(samples, (s) => (s?.t ?? 0) > cut);
}

if (!history_on()) {
	unlink(STATE);
	exit(0);
}

let samples = prune(load_samples(), time());

while (true) {
	if (!history_on()) {
		unlink(STATE);
		exit(0);
	}
	const started = now_ms();
	const t = time();
	push(samples, { t, d: snapshot() });
	samples = prune(samples, t);
	save(samples);

	const wait = INTERVAL * 1000 - (now_ms() - started);
	if (wait > 0)
		sleep(int(wait));
}
