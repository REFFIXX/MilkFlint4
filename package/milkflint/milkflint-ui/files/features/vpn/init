#!/bin/sh /etc/rc.common
# MilkFlint VPN client (ui feature "vpn"):
# 1) When "Use VPN's DNS" is on, runs a lightweight dnsmasq on port 5455 as
#    user adguardvpn for marked devices, with nftables table inet
#    milkflint_vpn_dns.
# 2) A dead-tunnel timer: when the peer stops answering and the kill switch
#    is off, inserts a main-table fallthrough for the tunnel mark so devices
#    go out directly until a handshake returns.

START=95
STOP=06
USE_PROCD=1

TABLE=milkflint_vpn_dns

vpn_dns_args() {
	ucode -e '
		import * as v from "/usr/libexec/milkflint/vpn-dns.uc";
		const args = v.dnsmasq_args();
		if (args)
			print(join("\n", args), "\n");
	' 2> /dev/null
}

apply_nft() {
	ucode -e '
		import * as v from "/usr/libexec/milkflint/vpn-dns.uc";
		v.apply_nft();
	' 2> /dev/null
}

clear_nft() {
	nft delete table inet $TABLE 2> /dev/null
}

dead_check() {
	ucode -e '
		import * as d from "/usr/libexec/milkflint/vpn-dead.uc";
		d.check();
	' 2> /dev/null
}

dead_clear() {
	ucode -e '
		import * as d from "/usr/libexec/milkflint/vpn-dead.uc";
		d.clear();
	' 2> /dev/null
}

start_service() {
	local args
	if [ -x /usr/sbin/dnsmasq ] && grep -q '^adguardvpn:' /etc/passwd; then
		args=$(vpn_dns_args)
	fi
	if [ -n "$args" ]; then
		local IFS='
'
		procd_open_instance dns
		procd_set_param command /usr/sbin/dnsmasq $args
		procd_set_param user adguardvpn
		procd_set_param group adguardvpn
		procd_set_param no_new_privs 1
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
		apply_nft
	else
		clear_nft
	fi

	# every 30s: fallthrough when the peer is dead and kill switch is off
	procd_open_instance dead
	procd_set_param command /bin/sh -c 'while true; do ucode -e "import * as d from \"/usr/libexec/milkflint/vpn-dead.uc\"; d.check();" 2>/dev/null; sleep 30; done'
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
	dead_check
}

service_stopped() {
	clear_nft
	dead_clear
	return 0
}

service_triggers() {
	procd_add_reload_trigger firewall network milkflint dhcp
}

# Never call `stop` here: `stop` deletes the service and its reload triggers
# from procd, so a later UCI change wouldn't start it again. Calling `start`
# replaces the service in place (stopping `dns` if no longer wanted and
# clearing the nftables table) while keeping its triggers registered.
reload_service() {
	start
}
