#!/bin/sh
# Uplink MU-MIMO / uplink OFDMA for the Wi-Fi driver (mt76 STA_REC_MURU
# cfg.mimo_ul_en / cfg.ofdma_ul_en), from milkflint.wifi:
#   muru_mimo_ul  "1" on, unset (or anything else) off
#   muru_ofdma_ul "1" on, unset (or anything else) off
#
# Both default off. On MT7986, stock mt76 hard-wires UL MU-MIMO on and that
# schedules uplink trigger bursts that can stall best-effort TX for ~65-300 ms
# (OddBlueDog / MilkFlint). MT7996 already left the flags clear; these params
# keep that default and let the Performance Tuning / Wi-Fi page opt in.
#
# The firmware keeps the first station's setting per band, so a change applies
# to devices that join after it; already-associated clients keep the old flag
# until they rejoin. milkflint-tuning runs this at boot and on reload; the
# ieee80211 hotplug (30-milkflint-aql) runs it as a radio appears.
#
#   wifi-muru-ul

set_param() {
	local mod=$1 name=$2 want=$3 p
	p=/sys/module/$mod/parameters/$name
	[ -w "$p" ] || return 0
	echo "$want" > "$p"
}

mimo=0
ofdma=0
[ "$(uci -q get milkflint.wifi.muru_mimo_ul)" = 1 ] && mimo=1
[ "$(uci -q get milkflint.wifi.muru_ofdma_ul)" = 1 ] && ofdma=1

for mod in mt7996e mt7915e; do
	[ -d "/sys/module/$mod" ] || continue
	set_param "$mod" muru_mimo_ul "$mimo"
	set_param "$mod" muru_ofdma_ul "$ofdma"
done

exit 0
